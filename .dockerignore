# The manager image is built from the repository root. Keep a site's state and
# secrets, and everything the image does not use, out of the build context.
.git
.github
.claude
**/node_modules
data
.env
ghost.env
.ghost-docker.json
.ghost-docker-import
.ghost-docker-probe
.ghost-docker.lock
.ghost-docker-update
.ghost-docker-restore
backups
.import
caddy/sites/*.caddy
caddy/custom/*.caddy
caddy/global/*.caddy
docs
pages
scripts
tests
manager/test
# Only the integration stage copies these; the image that ships never does.
!manager/test/integration
!manager/test/dotenv.ts
*.md
