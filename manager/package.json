{
  "name": "ghost-docker-manager",
  "private": true,
  "description": "The ghost-docker CLI. Runs inside the manager image; see docs/ghost-cli-replacement.md §2.10.",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write src test package.json tsconfig.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json",
    "lint": "oxlint src test",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test --test-timeout=60000 'test/*.test.ts'"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
