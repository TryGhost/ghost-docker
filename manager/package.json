{
  "name": "ghost-docker-manager",
  "private": true,
  "description": "The ghost-docker CLI. Runs inside the manager image; see docs/architecture.md#launcher-and-manager.",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write src test package.json tsconfig.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json",
    "lint": "oxlint src test",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test --test-timeout=60000 'test/*.test.ts'",
    "test:integration": "bash test/integration/run.sh"
  },
  "dependencies": {
    "@inquirer/input": "5.1.7",
    "@inquirer/select": "5.2.6",
    "execa": "10.0.1",
    "mysql2": "3.24.5",
    "picospinner": "3.1.2",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "undici": "^8.11.2",
    "unique-names-generator": "4.7.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
