#!/usr/bin/env bash
# ghost-docker: start the ghost-docker manager.
#
#   ghost-docker [--dir PATH] <command> [options]
#   ghost-docker help
#
# Everything ghost-docker does happens in a container, the manager image. This
# script is the only part that runs on the host, and it does three things:
# check that Docker can be used, decide which image to run, and run it with the
# site directory, the Docker socket and your identity. The manager's exit
# status is this script's exit status.
#
#   --dir PATH   The site directory. Default: the current directory.
#
#   ghost-docker install --migrate[=PATH] [install options]
#
# moves a local Ghost-CLI site (the current directory, or PATH) into a new
# Docker site beside it. It is the one command with work on the host, because
# Ghost-CLI and the source site are here and not in the image: this script runs
# `ghost migrate-export` there, then hands the bundle to `install --import`.
#
# Which image runs, first match wins:
#
#   GD_IMAGE           an image you name
#   a pinned image     written into a site's own copy of this script at install
#   a checkout         this script next to manager/Dockerfile builds from it
#   GD_CHANNEL         a published channel (default: edge), pulled every time
#
# Requires bash and Docker with the Compose plugin. Nothing else. On Windows,
# run it inside WSL2. The contract this implements is
# docs/ghost-cli-replacement.md §2.10.
set -euo pipefail

readonly GD_REGISTRY_IMAGE="ghcr.io/tryghost/ghost-docker"
# Replaced with `repository@sha256:...` in the copy installed into a site.
readonly GD_PINNED_IMAGE=""
# How long Docker may take to answer before it is treated as not running. A
# daemon that has wedged stops answering rather than returning an error.
GD_DOCKER_TIMEOUT=${GD_DOCKER_TIMEOUT:-20}

die() {
    printf 'error: %s\n' "$1" >&2
    exit "${2:-1}"
}

# with_deadline SECONDS COMMAND...
# 124 when the command had to be killed. `timeout(1)` is not on macOS.
with_deadline() {
    local seconds=$1 pid waited=0
    shift
    "$@" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if ((waited >= seconds)); then
            kill -9 "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            return 124
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "$pid"
}

# --- Options that belong to the launcher ------------------------------------

site_dir=""
# The --import argument's index in args, when there is one.
bundle_at=""
# The Ghost-CLI site --migrate exports, when it is given. The option is the
# launcher's alone: the manager is given the bundle, as --import.
migrate_source=""
migrating=0
declare -a args=()
while (($#)); do
    case $1 in
        --migrate) migrating=1 migrate_source=$PWD ;;
        --migrate=*)
            [[ -n ${1#*=} ]] || die "--migrate=PATH needs a path; plain --migrate uses the current directory" 2
            migrating=1 migrate_source=${1#*=}
            ;;
        --dir)
            [[ ${2:-} ]] || die "--dir needs a path" 2
            site_dir=$2
            shift
            ;;
        --dir=*) site_dir=${1#*=} ;;
        # The manager's option, but the bundle has to be mounted for it to
        # see it; the manager validates it like any other argument.
        --import)
            args+=("$1")
            if (($# > 1)); then
                bundle_at=${#args[@]}
                args+=("$2")
                shift
            fi
            ;;
        --import=*)
            args+=(--import)
            bundle_at=${#args[@]}
            args+=("${1#*=}")
            ;;
        *) args+=("$1") ;;
    esac
    shift
done

# --- Can Docker be used? ----------------------------------------------------
#
# These are the only checks that cannot run in the manager, because without
# them there is no manager. Each says what to do next.

host_os=$(uname -s 2>/dev/null || printf 'unknown')
case $host_os in
    MINGW* | MSYS* | CYGWIN*)
        die "this shell ($host_os) cannot run ghost-docker.
  On Windows, run it inside WSL2: install Docker Desktop with the WSL2 backend,
  open a WSL terminal, and run ./ghost-docker there."
        ;;
esac

command -v docker >/dev/null 2>&1 ||
    die "Docker is not installed, or is not on the PATH.
  Install Docker Engine (Linux) or Docker Desktop: https://docs.docker.com/get-docker/"

# Access is established by asking the daemon, never from group membership:
# neither rootless Docker nor a remote DOCKER_HOST involves the docker group.
rc=0
security=$(with_deadline "$GD_DOCKER_TIMEOUT" docker info --format '{{.SecurityOptions}}' 2>/dev/null </dev/null) || rc=$?
if ((rc == 124)); then
    die "the Docker daemon did not answer within ${GD_DOCKER_TIMEOUT} seconds.
  It may be starting, or stuck. Wait for it to report running, or restart it."
elif ((rc != 0)); then
    die "the Docker daemon is not reachable.
  Start Docker and try again. If it is running, this user may not be allowed to use it:
  check \`docker info\`."
fi

with_deadline "$GD_DOCKER_TIMEOUT" docker compose version >/dev/null 2>&1 </dev/null ||
    die "the Docker Compose plugin is not installed.
  ghost-docker sites are run with \`docker compose\`. See https://docs.docker.com/compose/install/"

rootless=0
case $security in *rootless*) rootless=1 ;; esac

# --- A Ghost-CLI site to migrate --------------------------------------------
#
# Everything that can refuse is checked before anything changes, the source
# least of all: the export stops it. docs/ghost-cli-replacement.md §2.4,
# "--migrate", is the contract.

readonly MIN_GHOST_CLI=1.33.0

# version_at_least VERSION MINIMUM -- both X.Y.Z
version_at_least() {
    local -a have want
    local i
    IFS=. read -ra have <<<"$1"
    IFS=. read -ra want <<<"$2"
    for i in 0 1 2; do
        ((10#${have[i]:-0} == 10#${want[i]:-0})) || return $((10#${have[i]:-0} < 10#${want[i]:-0}))
    done
}

# source_facts DIR -> `key=value` lines read from a Ghost-CLI installation's
# own files. Node is there: Ghost-CLI runs on it. The environment is chosen as
# Ghost-CLI chooses it: production when that configuration exists.
source_facts() {
    node - "$1" <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const dir = process.argv[2];
const read = (file) => {
    try {
        return JSON.parse(fs.readFileSync(path.join(dir, file), 'utf8'));
    } catch {
        return null;
    }
};
const cli = read('.ghost-cli') ?? {};
const environment = fs.existsSync(path.join(dir, 'config.production.json')) ? 'production' : 'development';
const config = read(`config.${environment}.json`) ?? {};
const facts = {
    version: cli['active-version'] ?? read('current/package.json')?.version ?? '',
    environment,
    process: config.process ?? 'local',
    port: config.server?.port ?? '',
};
for (const [key, value] of Object.entries(facts)) {
    console.log(`${key}=${String(value).replace(/\s/g, '')}`);
}
NODE
}

# Whether Ghost-CLI's local process manager has the site running: its pid file
# names a live process.
source_running() {
    local pid
    pid=$(cat -- "$migrate_source/.ghostpid" 2>/dev/null) || return 1
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

# Whether anything accepts connections on a loopback port.
port_in_use() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# After a failure: the operator is put back where they began.
restore_source() {
    if ((!source_was_running)); then
        printf 'The source site in %s was not running before, and is still stopped.\n' "$migrate_source" >&2
        return
    fi
    printf '\nStarting the source site again, because it was running before: ghost start in %s\n' "$migrate_source" >&2
    if (cd -- "$migrate_source" && ghost start) </dev/null >&2; then
        printf 'The source site is running again, as it was.\n' >&2
    else
        printf "error: the source site could not be started. Run \`ghost start\` in %s.\n" "$migrate_source" >&2
    fi
}

no_prompt=0
port_given=0
source_was_running=0
created_site_dir=0
if ((migrating)); then
    [[ ${args[0]:-} == install ]] ||
        die "--migrate is an option of install: ghost-docker install --migrate[=PATH]" 2
    for arg in "${args[@]}"; do
        case $arg in
            --import | --import=*)
                die "choose one: --import BUNDLE, or --migrate to export a Ghost-CLI site first" 2
                ;;
            --no-prompt) no_prompt=1 ;;
            --port | --port=*) port_given=1 ;;
        esac
    done

    [[ -d $migrate_source ]] || die "$migrate_source is not a directory. Nothing has been changed." 2
    migrate_source=$(CDPATH='' cd -- "$migrate_source" && pwd -P)
    [[ -f $migrate_source/.ghost-cli ]] ||
        die "$migrate_source is not a Ghost-CLI installation: it has no .ghost-cli file.
  Run this from the site's directory, or name it with --migrate=PATH. Nothing has been changed."

    # `.ghost-cli` records the version last used there, not the one installed.
    update_cli="Update it with \`npm install -g ghost-cli@latest\`, then run this again. Nothing has been changed."
    command -v ghost >/dev/null 2>&1 ||
        die "--migrate runs \`ghost migrate-export\` from Ghost-CLI $MIN_GHOST_CLI or later, and \`ghost\` is not on the PATH.
  $update_cli"
    # Run away from any installation, which would otherwise be inspected too.
    cli_version=$( (cd / && ghost --version) </dev/null 2>/dev/null |
        sed -n 's/^Ghost-CLI version: *\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1) || true
    if [[ -z $cli_version ]] || ! version_at_least "$cli_version" "$MIN_GHOST_CLI"; then
        die "--migrate needs Ghost-CLI $MIN_GHOST_CLI or later, which has \`ghost migrate-export\`; this host has ${cli_version:-a version that \`ghost --version\` does not report}.
  $update_cli"
    fi

    source_version="" source_process="" source_port=""
    while IFS='=' read -r key value; do
        case $key in
            version) source_version=$value ;;
            process) source_process=$value ;;
            port) source_port=$value ;;
        esac
    done < <(source_facts "$migrate_source")

    if [[ $source_process != local ]]; then
        die "$migrate_source is a production installation (process manager: $source_process).
  --migrate moves local installations in this release; production import and cutover
  come in a later release (plan step S5e). Until then a production site stays on
  Ghost-CLI, or moves with scripts/migrate.sh on the main branch. Nothing has been changed."
    fi
    case $source_version in
        [0-5].*)
            die "$migrate_source runs Ghost $source_version, and migration needs Ghost 6.
  Run \`ghost update\` there first, then run this again. Nothing has been changed."
            ;;
    esac

    # Beside the source, not in it: the exporter refuses an output inside the
    # installation, and so the Docker site is kept out of it too.
    [[ -n $site_dir ]] || site_dir="$(dirname -- "$migrate_source")/$(basename -- "$migrate_source")-docker"
    if [[ -d $site_dir ]]; then
        site_dir=$(CDPATH='' cd -- "$site_dir" && pwd -P)
    else
        [[ -d $(dirname -- "$site_dir") ]] ||
            die "$(dirname -- "$site_dir") does not exist, so the site directory $site_dir cannot be made there." 2
        site_dir="$(CDPATH='' cd -- "$(dirname -- "$site_dir")" && pwd -P)/$(basename -- "$site_dir")"
    fi
    case $site_dir/ in
        "$migrate_source"/*)
            die "the site directory $site_dir is inside the Ghost-CLI installation.
  Choose one outside it with --dir, or leave --dir out to use one beside it. Nothing has been changed." 2
            ;;
    esac
    if [[ -d $site_dir && -n $(ls -A -- "$site_dir") ]]; then
        die "$site_dir is not empty. A migrated site is installed into a new, empty directory.
  Name another with --dir. Nothing has been changed."
    fi

    source_running && source_was_running=1
    printf 'Migrating the Ghost-CLI site in %s (Ghost %s)\n' "$migrate_source" "${source_version:-of unknown version}"
    printf '  into a new Docker site in %s.\n' "$site_dir"
    if ((source_was_running)); then
        printf '  It is running now. The export stops it and leaves it stopped, so the Docker site\n'
        printf '%s\n' "  can take its port; \`ghost start\` there brings it back. Nothing else in it changes."
    else
        printf '  It is stopped, and stays stopped. Nothing in it changes.\n'
    fi
    if ((!no_prompt)); then
        (exec </dev/tty) 2>/dev/null ||
            die "--migrate asks before it stops the source site, and there is no terminal to ask at.
  Pass --no-prompt to go ahead without asking." 2
        printf 'Continue? [y/N] '
        answer=""
        read -r answer </dev/tty || true
        case $answer in
            [yY] | [yY][eE][sS]) ;;
            *) die "nothing was done." ;;
        esac
    fi
    if [[ ! -d $site_dir ]]; then
        mkdir -- "$site_dir"
        created_site_dir=1
    fi
fi

# --- The site directory -----------------------------------------------------

[[ -n $site_dir ]] || site_dir=$PWD
[[ -d $site_dir ]] || die "$site_dir is not a directory. Create it, or name another with --dir." 2
# The daemon resolves Compose bind mounts against host paths, so the manager
# must see the site at exactly the path the host does: resolved, and mounted
# at itself.
site_dir=$(CDPATH='' cd -- "$site_dir" && pwd -P)
case $site_dir in
    *:*) die "the site directory's path contains a colon, which Docker cannot mount: $site_dir" 2 ;;
esac

# --- The Docker socket ------------------------------------------------------

# On Docker Desktop and OrbStack the daemon is in a VM, and the socket to
# mount is the one inside it, at the default path, whatever the host-side
# path of the context's socket is. On Linux it is the socket the client uses.
socket=/var/run/docker.sock
if [[ $host_os == Linux ]]; then
    endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || printf '')}
    case $endpoint in
        unix://*) socket=${endpoint#unix://} ;;
        '') ;;
        *)
            die "Docker is configured to use a remote daemon ($endpoint).
  ghost-docker mounts the site directory into its manager, and a remote daemon
  would look for that directory on the other machine. Use a local daemon."
            ;;
    esac
    [[ -S $socket ]] || die "the Docker socket was not found at $socket."
fi

# --- Which image ------------------------------------------------------------

# Empty when this script is being read from a pipe (`curl ... | bash`): there is
# no file, so there is no checkout to find beside it.
script_dir=""
if [[ -n ${BASH_SOURCE[0]:-} && -f ${BASH_SOURCE[0]} ]]; then
    script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
fi
source_kind=image
# A channel is a tag that moves, and `docker run` would otherwise keep using
# whichever copy of it this host pulled first.
declare -a pull=()
if [[ -n ${GD_IMAGE:-} ]]; then
    image=$GD_IMAGE
elif [[ -n $GD_PINNED_IMAGE ]]; then
    image=$GD_PINNED_IMAGE
elif [[ -n $script_dir && -f $script_dir/manager/Dockerfile && -f $script_dir/compose.yml ]]; then
    # A checkout of the repository: build the manager from it. Docker's build
    # cache makes this quick when nothing has changed.
    source_kind=checkout
    image=ghost-docker:checkout
    commit=$(git -C "$script_dir" rev-parse HEAD 2>/dev/null || printf '')
    # Also tagged with its commit, so the image that belongs to an earlier
    # checkout is still here if an update has to go back to it.
    declare -a tags=(--tag "$image")
    [[ -z $commit ]] || tags+=(--tag "ghost-docker:checkout-${commit:0:12}")
    if ! build_output=$(docker build --quiet \
        --file "$script_dir/manager/Dockerfile" \
        --build-arg "GD_VERSION=checkout" --build-arg "GD_COMMIT=$commit" \
        "${tags[@]}" "$script_dir" 2>&1); then
        printf '%s\n' "$build_output" >&2
        die "the manager image could not be built from $script_dir."
    fi
else
    image="$GD_REGISTRY_IMAGE:${GD_CHANNEL:-edge}"
    pull=(--pull always --quiet)
fi

# --- The export, for --migrate -----------------------------------------------
#
# Last before the manager, so a host that cannot run it has refused already:
# from here the source is stopped. The bundle goes into a private directory
# beside the source, outside both sites, and is kept: after a failed import it
# can be imported again with --import, without stopping anything.

migrate_bundle=""
if ((migrating)); then
    bundle_home=$(mktemp -d "$(dirname -- "$migrate_source")/ghost-migration-$(basename -- "$migrate_source").XXXXXX")
    migrate_bundle=$bundle_home/bundle
    export_log=$bundle_home/export.log
    declare -a exporter=(ghost migrate-export --output "$migrate_bundle" --leave-stopped --force)
    ((!no_prompt)) || exporter+=(--no-prompt)
    printf '\nExporting the source site: %s\n' "${exporter[*]}"
    # The exporter's own output, unchanged, and a copy to read its reason from.
    export_rc=0
    if (exec </dev/tty) 2>/dev/null; then
        (cd -- "$migrate_source" && "${exporter[@]}") </dev/tty 2>&1 | tee "$export_log" || export_rc=${PIPESTATUS[0]}
    else
        (cd -- "$migrate_source" && "${exporter[@]}") </dev/null 2>&1 | tee "$export_log" || export_rc=${PIPESTATUS[0]}
    fi
    # The exporter exits 0 when its confirmation is declined, with no bundle.
    if ((export_rc == 0)) && [[ ! -f $migrate_bundle/manifest.json ]]; then
        export_rc=1
    fi
    if ((export_rc != 0)); then
        printf '\n%s\n' "error: \`ghost migrate-export\` did not make a bundle; its output is above." >&2
        if grep -q 'values MySQL would reject' "$export_log"; then
            printf '%s\n' \
                '  This SQLite site holds data MySQL would refuse, so it cannot move as a database.' \
                '  Either fix those rows in the source and run this again, or move the site through' \
                '  Ghost Admin: in the source, run' \
                '    ghost migrate-export --sqlite-format portable --output PATH' \
                "  then \`./ghost-docker install --import PATH\`, which says how to finish it." >&2
        fi
        rm -rf -- "$bundle_home"
        ((!created_site_dir)) || rmdir -- "$site_dir" 2>/dev/null || true
        restore_source
        exit 1
    fi
    rm -f -- "$export_log"

    # The source's port, now that the export has stopped it, unless something
    # else holds it; the manager then chooses the first free one.
    if ((!port_given)) && [[ $source_port =~ ^[0-9]+$ ]]; then
        if port_in_use "$source_port"; then
            printf '\nPort %s, the source site'"'"'s, is in use by something else, so the Docker site takes another.\n' "$source_port"
        else
            args+=(--port "$source_port")
        fi
    fi
    args+=(--import)
    bundle_at=${#args[@]}
    args+=("$migrate_bundle")
fi

# --- A bundle to import -----------------------------------------------------
#
# Mounted read-only, at its own resolved absolute path, like the site
# directory. A path that does not exist is passed on as given, for the
# manager to report.
declare -a bundle_mount=()
bundle=${bundle_at:+${args[bundle_at]}}
if [[ -n $bundle && -e $bundle ]]; then
    if [[ -d $bundle ]]; then
        bundle=$(CDPATH='' cd -- "$bundle" && pwd -P)
    else
        bundle="$(CDPATH='' cd -- "$(dirname -- "$bundle")" && pwd -P)/$(basename -- "$bundle")"
    fi
    bundle_mount=(--volume "$bundle:$bundle:ro")
    args[bundle_at]=$bundle
fi

# --- Run it -----------------------------------------------------------------

declare -a run=(
    docker run --rm --init ${pull[@]+"${pull[@]}"}
    --volume "$socket:/var/run/docker.sock"
    --volume "$site_dir:$site_dir"
    --workdir "$site_dir"
    --env "GD_SITE_DIR=$site_dir"
    --env "GD_UID=$(id -u)"
    --env "GD_GID=$(id -g)"
    --env "GD_ROOTLESS=$rootless"
    --env "GD_HOST_OS=$host_os"
    --env "GD_IMAGE=$image"
    --env "GD_SOURCE=$source_kind"
)
[[ -z ${NO_COLOR:-} ]] || run+=(--env "NO_COLOR=$NO_COLOR")
# Extra Compose files for the manager's own Compose runs (docs/configuration.md).
[[ -z ${GD_COMPOSE_OVERRIDES:-} ]] || run+=(--env "GD_COMPOSE_OVERRIDES=$GD_COMPOSE_OVERRIDES")
[[ -z ${TERM:-} ]] || run+=(--env "TERM=$TERM")
# Keep a failed import's site for inspection instead of removing it (docs/install.md).
[[ -z ${GD_IMPORT_KEEP_FAILED:-} ]] || run+=(--env "GD_IMPORT_KEEP_FAILED=$GD_IMPORT_KEEP_FAILED")
run+=(${bundle_mount[@]+"${bundle_mount[@]}"})

# A terminal is attached when there is one, including when this script was
# piped from curl and stdin is therefore the script itself. The manager
# replaces this script, so its status is ours, except after a migration's
# export, when a failure has the source to put back.
declare -a launch=(exec)
((!migrating)) || launch=()
manager_rc=0
if [[ -t 0 && -t 1 ]]; then
    run+=(--interactive --tty)
    "${launch[@]}" "${run[@]}" "$image" ${args[@]+"${args[@]}"} || manager_rc=$?
elif [[ -t 1 ]] && (exec </dev/tty) 2>/dev/null; then
    run+=(--interactive --tty)
    "${launch[@]}" "${run[@]}" "$image" ${args[@]+"${args[@]}"} </dev/tty || manager_rc=$?
else
    "${launch[@]}" "${run[@]}" "$image" ${args[@]+"${args[@]}"} </dev/null || manager_rc=$?
fi

# Only a migration gets here.
if ((manager_rc == 0)); then
    printf '%s
' \
        "The source site in $migrate_source is stopped and intact; \`ghost start\` there brings it back." \
        "The bundle is kept in $migrate_bundle. It holds the site's configuration, secrets" \
        "included: remove it once you no longer need it."
    exit 0
fi
printf '\nThe import did not finish. The bundle is kept in %s;\n' "$migrate_bundle" >&2
printf '  to try again without exporting, run install --import %s\n' "$migrate_bundle" >&2
((!created_site_dir)) || rmdir -- "$site_dir" 2>/dev/null || true
restore_source
exit "$manager_rc"
