#!/usr/bin/env bash
set -e

# Check if .tinyb exists in current directory
if [[ ! -f "./.tinyb" ]]
then
    # If not, try to copy from home directory
    if [[ -f "/home/tinybird/.tinyb" ]]
    then
        cp /home/tinybird/.tinyb ./.tinyb
        echo "Copied .tinyb auth file to current directory" >&2
    else
        echo "No .tinyb auth file found, please run 'docker compose run --rm tinybird-login' first to login" >&2
        exit 1
    fi
fi

# Run the tinybird command
tb "$@"
